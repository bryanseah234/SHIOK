# Copy to .env (gitignored). Same keys go into Vercel env vars for the deployed proxy.

# LTA DataMall — register free at datamall.lta.gov.sg
LTA_DATAMALL_ACCOUNT_KEY=

# OneMap — register free at onemap.gov.sg (token fetched at runtime, ~3-day expiry)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Pipeline
PILOT_AREAS=Toa Payoh,Bukit Timah,Downtown Core
RAW_DIR=./raw
SHELTER_LAMBDA=0.6          # uncovered-edge penalty for sheltered routing (T1.2)
DETOUR_BUDGET=1.25          # sheltered path max length vs shortest (LOCKED, PRD D2)

# Vercel: no key here — owner authenticates once with `vercel login`
