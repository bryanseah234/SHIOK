{
  "name": "shiok-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^h3-js$": "<rootDir>/node_modules/h3-js"
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "strict": true } }]
    },
    "testMatch": ["**/lib/__tests__/**/*.test.ts"]
  },
  "dependencies": {
    "h3-js": "4.1.0",
    "maplibre-gl": "4.7.1",
    "next": "^15.5.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  }
}
